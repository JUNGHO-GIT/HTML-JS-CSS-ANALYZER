{
  "name": "html-js-css-analyzer",
  "displayName": "Html-Js-Css-Analyzer",
  "description": "HTML, JavaScript, CSS analyzer and linter extension for Visual Studio Code.",
  "publisher": "JUNGHO",
  "icon": "logo.webp",
  "license": "Apache-2.0",
  "version": "3.2.6",
  "main": "./out/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/JUNGHO-GIT/HTML-JS-CSS-ANALYZER.git"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "css",
    "html",
    "javascript",
    "jshint",
    "htmlhint",
    "intellisense",
    "diagnostics",
    "unused",
    "selectors"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:html",
    "onLanguage:css",
    "onLanguage:javascript",
    "onCommand:Html-Js-Css-Analyzer.validate",
    "onCommand:Html-Js-Css-Analyzer.clear"
  ],
  "contributes": {
    "outputChannels": [
      "Html-Js-Css-Analyzer"
    ],
    "commands": [
      {
        "command": "Html-Js-Css-Analyzer.validate",
        "title": "Html-Js-Css-Analyzer: Validate Current Document"
      },
      {
        "command": "Html-Js-Css-Analyzer.clear",
        "title": "Html-Js-Css-Analyzer: Clear Style Cache"
      }
    ],
    "configuration": {
      "title": "Html-Js-Css-Analyzer",
      "properties": {
        "Html-Js-Css-Analyzer.logLevel": {
          "type": "string",
          "scope": "window",
          "enum": [
            "off",
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info"
        },
        "Html-Js-Css-Analyzer.exclude": {
          "type": "array",
          "scope": "resource",
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/dist/**",
            "**/out/**",
            "**/.svn/**",
            "**/.hg/**",
            "**/CVS/**",
            "**/.idea/**",
            "**/.vscode/**",
            "**/.settings/**",
            "**/.metadata/**",
            "**/.history/**",
            "**/.backup/**",
            "**/.etc/**",
            "**/.cache/**",
            "**/.gradle/**",
            "**/.mvn/**",
            "**/bin/**",
            "**/build/**",
            "**/target/**",
            "**/logs/**",
            "**/.pytest_cache/**",
            "**/.scannerwork/**",
            "**/.terraform/**",
            "**/__pycache__/**",
            "**/.venv/**",
            "**/.classpath",
            "**/.project",
            "**/.factorypath",
            "**/.DS_Store",
            "**/Thumbs.db",
            "**/desktop.ini",
            "**/.coverage"
          ],
          "items": {
            "type": "string"
          }
        },
        "Html-Js-Css-Analyzer.additionalExtensions": {
          "type": "array",
          "scope": "resource",
          "default": [
            "html",
            "js",
            "css"
          ],
          "items": {
            "type": "string"
          },
          "description": "[Html-Js-Css-Analyzer] Additional file extensions to analyze"
        },
        "Html-Js-Css-Analyzer.htmlHint.enabled": {
          "type": "boolean",
          "scope": "resource",
          "default": true,
          "description": "[Html-Js-Css-Analyzer] Enable/disable HTML analysis and hints"
        },
        "Html-Js-Css-Analyzer.cssHint.enabled": {
          "type": "boolean",
          "scope": "resource",
          "default": true,
          "description": "[Html-Js-Css-Analyzer] Enable/disable CSS analysis and hints"
        },
        "Html-Js-Css-Analyzer.jsHint.enabled": {
          "type": "boolean",
          "scope": "resource",
          "default": false,
          "description": "[Html-Js-Css-Analyzer] Enable/disable JavaScript analysis and hints"
        }
      }
    }
  },
  "engines": {
    "vscode": ">=1.108.0",
    "node": ">=21.0.0",
    "npm": ">=10.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "sync": "bun .node/mjs/sync.mjs --bun --sync --server",
    "start": "bun .node/mjs/swc.mjs --bun --start --server",
    "build": "bun .node/mjs/swc.mjs --bun --build --server",
    "fix": "bun .node/mjs/fix.mjs --bun --fix",
    "reset": "bun .node/mjs/reset.mjs --bun --reset",
    "vsce": "bun .node/mjs/vsce.mjs --bun --package",
    "git-push-y": "bun .node/mjs/git.mjs --bun --push --y",
    "git-push-n": "bun .node/mjs/git.mjs --bun --push --n"
  },
  "dependencies": {
    "css-tree": "^3.1.0",
    "htmlhint": "^1.8.0",
    "jshint": "^2.13.6"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.7.1",
    "@swc/cli": "0.7.10",
    "@swc/core": "1.15.10",
    "@swc/helpers": "0.5.18",
    "@types/css-tree": "^2.3.11",
    "@types/eslint": "9.6.1",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@types/htmlhint": "^1.1.5",
    "@types/jshint": "^2.12.4",
    "@types/node": "25.0.10",
    "@types/vscode": "^1.108.1",
    "@typescript-eslint/eslint-plugin": "8.53.1",
    "@typescript-eslint/parser": "8.53.1",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "0.27.2",
    "eslint": "9.39.2",
    "eslint-define-config": "2.1.0",
    "eslint-plugin-html": "8.1.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-unicorn": "62.0.0",
    "globals": "17.1.0",
    "ts-morph": "27.0.2",
    "ts-prune": "0.10.3",
    "tsc-alias": "1.8.16",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.1"
  }
}
